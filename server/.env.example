# ==============================================================================
# MAITRI CERAMIC - ERP BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================

# 1. SERVER CONFIGURATION
PORT=5000
NODE_ENV=development

# 2. DATABASE CONFIGURATION (MongoDB URI)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>

# 3. CORS CONFIGURATION
CORS_ORIGIN=*

# 4. JWT AUTHENTICATION
JWT_SECRET=your-secure-jwt-secret-key-min-32-chars
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_DAYS=7

# 5. DEFAULT SUPER ADMIN SEED CREDENTIALS
ADMIN_MOBILE=9825702369
ADMIN_EMAIL=admin@maitriceramic.com
ADMIN_PASSWORD=YourStrongPassword@123

# 6. CLOUDINARY STORAGE (For Product Imports, Excel & PDF Catalogs, Media)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
