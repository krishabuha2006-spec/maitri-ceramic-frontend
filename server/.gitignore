# 1. Dependency Directories
node_modules/
jspm_packages/
web_modules/

# 2. Environment Variables & Secrets (CRITICAL)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# 3. Logs & Debugging Files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 4. Runtime Data, PIDs & Seed Artifacts
pids/
*.pid
*.seed
*.pid.lock

# 5. Local Uploads & Temporary Cache
uploads/
temp/
tmp/
*.tmp
.cache/

# 6. Test Coverage & Test Reports
coverage/
.nyc_output/
*.lcov

# 7. Production Build & Bundles
dist/
build/
out/

# 8. OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 9. IDE & Code Editor Metadata
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

